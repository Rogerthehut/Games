# Quarter Maths on Replit. The app lives in maths/. One Node process serves the built app and the tutor API.
modules = ["nodejs-20"]
hidden = [".config", "maths/node_modules", "maths/dist", "maths/native"]
run = ["sh", "-c", "cd maths && npm ci --no-audit --no-fund && npm run build && npm run server"]

# Replit's Run button and Preview start the app through a workflow. This one builds the app and starts the server,
# and Replit shows the Preview once the server answers on port 5000. Dependencies are installed first only if missing.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "(pkill -f '[t]sx server/index.ts' || true); cd maths && ([ -d node_modules ] || npm ci --no-audit --no-fund) && npm run build && npm run server"
waitForPort = 5000

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"
# Replit sits behind a proxy, so the tutor service should read the real visitor address for rate limits.
TRUST_PROXY = "1"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd maths && npm ci --no-audit --no-fund && npm run build"]
run = ["sh", "-c", "cd maths && npm run server"]

[[deployment.rewrites]]
from = "/*"
to = "/index.html"
