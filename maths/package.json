{
  "name": "mathpath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "server": "node --enable-source-maps dist-server/index.mjs",
    "booklet": "tsx scripts/build-booklet.ts",
    "audit:worked": "tsx scripts/audit-worked.ts",
    "paper-sample": "tsx scripts/build-paper-sample.ts",
    "e2e:gate-position": "tsx scripts/gate-position-e2e.ts",
    "e2e:rail-switch": "tsx scripts/rail-switch-e2e.ts",
    "e2e:kid-pin": "tsx scripts/kid-pin-e2e.ts",
    "e2e:multi-screen": "tsx scripts/multi-screen-e2e.ts",
    "e2e:print-paper": "tsx scripts/print-paper-e2e.ts",
    "ops": "tsx scripts/ops.ts",
    "e2e:pathway": "tsx scripts/pathway-e2e.ts",
    "e2e:taps": "tsx scripts/tap-e2e.ts",
    "ks2-coverage": "tsx scripts/ks2-coverage.ts",
    "e2e:lesson": "tsx scripts/lesson-e2e.ts",
    "e2e:refresher": "tsx scripts/refresher-e2e.ts",
    "e2e:instruments": "tsx scripts/instruments-e2e.ts",
    "e2e:tools": "tsx scripts/tools-e2e.ts",
    "e2e:guides": "tsx scripts/guides-e2e.ts",
    "e2e:challenge": "tsx scripts/tables-challenge-e2e.ts",
    "e2e:report": "tsx scripts/learning-report-e2e.ts",
    "e2e:topicsearch": "tsx scripts/topic-search-e2e.ts",
    "fetch:11plus": "tsx scripts/fetch-11plus-pages.ts",
    "e2e:grownup": "tsx scripts/grownup-e2e.ts && VIEW=phone tsx scripts/grownup-e2e.ts",
    "ops:stats": "tsx scripts/ops.ts stats",
    "ops:feedback": "tsx scripts/ops.ts feedback",
    "ops:audit": "tsx scripts/ops.ts audit",
    "e2e:ops": "node scripts/ops-e2e.mjs",
    "e2e:memory": "tsx scripts/memory-e2e.ts",
    "e2e:idle": "tsx scripts/idle-e2e.ts",
    "e2e:tables-progress": "tsx scripts/tables-progress-e2e.ts",
    "e2e:tutor-read": "tsx scripts/tutor-read-e2e.ts",
    "reading-list": "tsx scripts/fetch-reading-list.ts",
    "icons": "node scripts/make-icons.mjs",
    "server:fake": "TUTOR_FAKE=1 tsx server/index.ts",
    "eval:tutor": "tsx server/eval/tutor-eval.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --sourcemap --outfile=dist-server/index.mjs --log-level=warning",
    "server:dev": "tsx server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@clerk/backend": "^3.27.0",
    "@clerk/clerk-js": "^6.42.3",
    "@clerk/ui": "^1.42.4",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@sentry/browser": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "pg": "^8.23.1",
    "preact": "^10.24.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@preact/preset-vite": "^2.10.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
