# Copy to .env for local use, or set these as Secrets in Replit. Never commit a real key.

# The tutor is off until a key is set (the app works fully without it).
# Pick one provider: anthropic or openrouter. If empty, Anthropic is used when its key is set, otherwise OpenRouter.
TUTOR_PROVIDER=
ANTHROPIC_API_KEY=

# OpenRouter (can use a free model). Read docs/TUTOR.md before using it with children.
OPENROUTER_API_KEY=
# openrouter/free picks a free model for you; or name one, e.g. vendor/model:free
OPENROUTER_MODEL=
# deny (default) only uses providers that do not keep or train on prompts. allow accepts that free providers may.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_ALLOW_FALLBACKS=
OPENROUTER_REFERER=
# Optional: which model and how hard it thinks. Defaults are set in server/tutor/provider.ts.
TUTOR_MODEL=
TUTOR_EFFORT=

# Answer from a script instead of the real model, for development with no key and no spend.
TUTOR_FAKE=0

# Serving
PORT=8787
# Set to 1 when behind a proxy (Replit, a load balancer) so rate limits see the real visitor address.
TRUST_PROXY=0
# Only needed if the app and the tutor are on different origins. Comma separated.
TUTOR_ALLOWED_ORIGINS=

# Tutor rate limits (optional)
TUTOR_PER_DEVICE_HOUR=
TUTOR_PER_DEVICE_DAY=
TUTOR_PER_IP_DAY=
TUTOR_GLOBAL_DAY=
