# Copy to .env for local use, or set these as Secrets in Replit. Never commit a real key.

# The tutor is off until a key is set (the app works fully without it).
# Pick one provider: anthropic or openrouter. If empty, Anthropic is used when its key is set, otherwise OpenRouter.
TUTOR_PROVIDER=
ANTHROPIC_API_KEY=

# OpenRouter (can use a free model). Read docs/TUTOR.md before using it with children.
OPENROUTER_API_KEY=
# openrouter/free picks a free model for you; or name one, e.g. vendor/model:free
OPENROUTER_MODEL=
# deny (default) only uses providers that do not keep or train on prompts. allow accepts that free providers may.
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_ALLOW_FALLBACKS=
OPENROUTER_REFERER=
# Optional: which model and how hard it thinks. Defaults are set in server/tutor/provider.ts.
TUTOR_MODEL=
TUTOR_EFFORT=

# Answer from a script instead of the real model, for development with no key and no spend.
TUTOR_FAKE=0

# Serving
PORT=8787
# Set to 1 when behind a proxy (Replit, a load balancer) so rate limits see the real visitor address.
TRUST_PROXY=0
# Only needed if the app and the tutor are on different origins. Comma separated.
TUTOR_ALLOWED_ORIGINS=

# Tutor rate limits (optional)
TUTOR_PER_DEVICE_HOUR=
TUTOR_PER_DEVICE_DAY=
TUTOR_PER_IP_DAY=
TUTOR_GLOBAL_DAY=

# Accounts: parents sign in with Clerk; learners' progress is stored in Postgres. See docs/ACCOUNTS.md.
# Server (secrets):
DATABASE_URL=
CLERK_SECRET_KEY=
# Optional: the origins your app is served from, if Clerk should only accept tokens issued for them. Comma separated.
CLERK_AUTHORIZED_PARTIES=
# Browser (set at build time; the publishable key is safe to ship):
VITE_CLERK_PUBLISHABLE_KEY=

# Development only. Replaces Clerk with a fake sign-in and, with no DATABASE_URL, an in-memory database. Refused in production.
AUTH_FAKE=0
VITE_FAKE_AUTH=0

# --- Payments (Stripe) ---
# With no STRIPE_SECRET_KEY there is no paywall. See docs/BILLING.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
TRIAL_DAYS=7
# The public address, used for Stripe's return links (no trailing slash)
APP_URL=https://yourquarter.co.uk
# Development only: pretend to take payment (ignored in production)
BILLING_FAKE=0

# App Store purchases (RevenueCat). A long random value you also paste into RevenueCat's webhook as its Authorization header. See docs/MOBILE.md.
REVENUECAT_WEBHOOK_AUTH=

# --- Parents' AI assistant ---
# Uses the same model service as the tutor (see above). Limits per parent:
ASSISTANT_PER_PARENT_DAY=40
ASSISTANT_PER_PARENT_HOUR=20
ASSISTANT_GLOBAL_DAY=3000

# --- Cloudflare Turnstile (human check on the AI endpoints) ---
# Create a Turnstile widget in the Cloudflare dashboard (add yourquarter.co.uk). The site key is public and is read at build time.
# With no secret, the check is off. Cloudflare's test keys (1x00000000000000000000AA / 1x0000000000000000000000000000000AA) always pass.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_PASS_MINUTES=30

# --- Reviews strip on the welcome page ---
# A link to your independent reviews page (for example your Trustpilot page). Empty shows "gathering its first reviews".
VITE_REVIEWS_URL=

# The team's ops page (/ops): see docs/OPS.md
OPS_ADMINS=
OPS_SESSION_SECRET=

# Crash reports (Sentry, EU region): see docs/MONITORING.md. Both are optional; nothing is sent without them.
VITE_SENTRY_DSN=
SENTRY_DSN=

# Server safety: see docs/SECURITY.md
# TRUSTED_PROXY_HOPS=1       # proxies in front of the server (Replit alone is 1)
# CSP_ENFORCE=1              # switch the content policy from report-only to enforcing, after checking the live site's console
# HSTS=1                     # force the HSTS header even when the proxy doesn't say it's HTTPS
# COUNTER_SECRET=            # optional: the secret used to hash visitor addresses in the rate-limit counters (defaults to CLERK_SECRET_KEY)

# Email sent to hello@ (docs/OPS.md): Resend's receiving passes it to /api/inbound/resend. The signing secret is on the webhook's page in Resend (starts whsec_).
# Needs RESEND_API_KEY too, with permission to read received email. Leave MAIL_REPLY_TO unset so replies to our emails come back here.
RESEND_WEBHOOK_SECRET=
# Optional: a second Resend key with only "read received email" permission, used just for fetching inbound mail. If unset, RESEND_API_KEY is used for both.
RESEND_RECEIVING_API_KEY=
